---
import { about } from '../data/site';
---

<section id="about" class="section">
	<div class="wrap">
		<div class="section-head">
			<span class="eyebrow">03 — Strengths</span>
		</div>

		<div class="about">

			<div class="about__groups">
				{
					about.groups.map((group) => (
						<section class="group">
							<h3 class="group__title">{group.title}</h3>
							<ul class="group__items">
								{group.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</section>
					))
				}
			</div>
			<p class="about__personal">{about.personal}</p>
		</div>
	</div>
</section>

<style>
	.about {
		max-width: 72ch;
	}

	.about__groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: 2rem;
		margin-top: 2.25rem;
	}

	.group__title {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-faint);
		font-weight: 600;
	}

	/* The lead group is the pitch; the second is supporting history. */
	.group:first-child .group__title {
		color: var(--accent);
	}

	.group__items {
		list-style: none;
		margin: 1rem 0 0;
		display: grid;
		gap: 0.55rem;
		color: var(--text-dim);
		font-size: 0.9375rem;
	}

	.group__items li {
		position: relative;
		padding-left: 1.15rem;
		line-height: 1.55;
	}

	.group__items li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--border-strong);
	}

	.group:first-child .group__items li::before {
		background: var(--accent);
	}

	.about__closing {
		margin-top: 2.25rem;
		color: var(--text-dim);
	}

	.about__personal {
		margin-top: 1.15rem;
		color: var(--text-faint);
		font-size: 0.9375rem;
	}
</style>
