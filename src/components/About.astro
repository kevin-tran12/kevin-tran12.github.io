---
import { about } from '../data/site';
---

<section id="about" class="section">
	<div class="wrap">
		<div class="section-head">
			<span class="eyebrow">01</span>
			<h2>About</h2>
		</div>

		<div class="about__body">
			{about.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</div>
</section>

<style>
	.about__body {
		display: grid;
		gap: 1.15rem;
		max-width: 68ch;
		color: var(--text-dim);
	}
</style>
