---
import { contact, hero } from '../data/site';

// Inline paths keep this to zero external requests — the old site loaded a
// ~4 MB Font Awesome webfont set to draw three small glyphs.
const icons: Record<string, string> = {
	LinkedIn:
		'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.75-1.95C21.4 8.75 22 11.3 22 14.4V21h-4v-5.9c0-1.4-.03-3.2-2-3.2s-2.3 1.5-2.3 3.1V21h-4z',
	GitHub:
		'M12 1.8a10.2 10.2 0 0 0-3.23 19.9c.51.1.7-.22.7-.49v-1.9c-2.84.6-3.44-1.2-3.44-1.2-.47-1.18-1.14-1.5-1.14-1.5-.93-.63.07-.62.07-.62 1.03.07 1.57 1.05 1.57 1.05.91 1.56 2.4 1.11 2.99.85.09-.66.36-1.11.65-1.37-2.27-.26-4.65-1.13-4.65-5.04 0-1.11.4-2.02 1.05-2.74-.11-.26-.46-1.3.1-2.71 0 0 .85-.27 2.8 1.05a9.7 9.7 0 0 1 5.1 0c1.94-1.32 2.8-1.05 2.8-1.05.55 1.41.2 2.45.1 2.71.65.72 1.04 1.63 1.04 2.74 0 3.92-2.38 4.78-4.66 5.03.37.32.69.94.69 1.9v2.8c0 .27.19.6.71.49A10.2 10.2 0 0 0 12 1.8z',
};
---

<section id="contact" class="section">
	<div class="wrap">
		<div class="section-head">
			<span class="eyebrow">06 — Get in touch</span>
		</div>

		<div class="contact">
			<p class="contact__lede lede">{contact.lede}</p>

			<a class="contact__email" href={`mailto:${contact.email}`}>{contact.email}</a>

			<ul class="contact__socials">
				{
					contact.socials.map((social) => (
						<li>
							<a class="social" href={social.url} rel="me noopener">
								<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									<path d={icons[social.name]} />
								</svg>
								{social.name}
							</a>
						</li>
					))
				}
			</ul>

			<p class="contact__note">{hero.location}</p>
		</div>
	</div>
</section>

<style>
	.contact {
		max-width: 60ch;
	}

	.contact__lede {
		margin-bottom: 1.75rem;
	}

	.contact__email {
		/* The primary action on the page, and on a phone it is a thumb
		   target as much as a link — hold it at 48px regardless of how the
		   fluid type scale lands. */
		display: inline-flex;
		align-items: center;
		min-height: 48px;
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 0.95rem + 1vw, 1.6rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		text-decoration: none;
		border-bottom: 1px solid var(--accent-border);
		padding-bottom: 0.15rem;
		word-break: break-word;
	}

	.contact__email:hover {
		border-bottom-color: currentColor;
	}

	.contact__socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		list-style: none;
		margin: 2rem 0 0;
	}

	.social {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 1rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--bg-elev);
		color: var(--text);
		font-size: 0.9rem;
		font-weight: 550;
		text-decoration: none;
		transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
	}

	.social:hover {
		border-color: var(--accent-border);
		background: var(--accent-soft);
		color: var(--accent);
	}

	.social svg {
		width: 17px;
		height: 17px;
		fill: currentColor;
	}

	.contact__note {
		margin-top: 1.75rem;
		color: var(--text-faint);
		font-size: 0.875rem;
	}
</style>
